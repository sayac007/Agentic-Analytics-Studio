{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-analytics-studio.invalid/contracts/manifest.schema.json",
  "title": "manifest v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "run_id",
    "stage",
    "claim",
    "data",
    "columns",
    "split",
    "missing_policy",
    "estimation",
    "response_grid",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "purpose": {
      "enum": [
        "contract_fixture",
        "development_benchmark"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "A"
    },
    "claim": {
      "const": "benchmark_recovery_not_real_causal_marketing_roi"
    },
    "data": {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "synthetic_media",
        "semi_synthetic_outcome"
      ],
      "properties": {
        "period": {
          "$ref": "common.schema.json#/$defs/lineage"
        },
        "synthetic_media": {
          "$ref": "common.schema.json#/$defs/synthetic_lineage"
        },
        "semi_synthetic_outcome": {
          "$ref": "common.schema.json#/$defs/synthetic_lineage"
        }
      }
    },
    "split": {
      "$ref": "common.schema.json#/$defs/split"
    },
    "missing_policy": {
      "const": "reject"
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "method",
        "target",
        "controls",
        "transform_order",
        "parameters",
        "parameter_policy",
        "specified_on",
        "uncertainty",
        "condition_number_limit"
      ],
      "properties": {
        "runtime": {
          "const": "python"
        },
        "method": {
          "const": "ols"
        },
        "target": {
          "const": "semi_synthetic_outcome"
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trend",
            "annual_fourier_order",
            "include_quarter_end",
            "structural_breaks"
          ],
          "properties": {
            "trend": {
              "const": "month_index_from_train_start"
            },
            "annual_fourier_order": {
              "const": 1
            },
            "include_quarter_end": {
              "type": "boolean"
            },
            "structural_breaks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "start",
                  "evidence_url",
                  "evidence_sha256",
                  "published_on",
                  "rationale"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "$ref": "common.schema.json#/$defs/month"
                  },
                  "evidence_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "evidence_sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  },
                  "published_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 0
            }
          }
        },
        "transform_order": {
          "const": [
            "geometric_adstock",
            "hill"
          ]
        },
        "parameters": {
          "$ref": "common.schema.json#/$defs/parameters"
        },
        "parameter_policy": {
          "const": "predeclared_oracle_transforms_without_baseline_or_truth_access"
        },
        "specified_on": {
          "type": "string",
          "format": "date"
        },
        "uncertainty": {
          "$ref": "common.schema.json#/$defs/uncertainty"
        },
        "condition_number_limit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "response_grid": {
      "$ref": "common.schema.json#/$defs/grid"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "$ref": "common.schema.json#/$defs/path"
        }
      }
    }
  }
}
