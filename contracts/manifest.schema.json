{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest contract v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "claim",
    "input_kind",
    "data",
    "columns",
    "split",
    "missing_policy",
    "estimation",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "const": "semi_synthetic_recovery_benchmark_not_real_tesla_roi"
    },
    "input_kind": {
      "enum": [
        "observed_reference",
        "synthetic_fixture"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "observed_registrations",
        "synthetic_media",
        "semi_synthetic_outcome"
      ],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "publisher",
            "source_or_generator",
            "access_date",
            "geography",
            "time_grain",
            "unit",
            "rights",
            "redistribution",
            "transformations",
            "limitations"
          ],
          "properties": {
            "class": {
              "enum": [
                "observed",
                "synthetic",
                "proxy"
              ]
            },
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "source_or_generator": {
              "type": "string",
              "minLength": 1
            },
            "access_date": {
              "type": "string",
              "format": "date"
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "time_grain": {
              "enum": [
                "month"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "rights": {
              "type": "string",
              "minLength": 1
            },
            "redistribution": {
              "enum": [
                "allowed",
                "not_allowed",
                "unknown"
              ]
            },
            "transformations": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observed_registrations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "publisher",
            "source_or_generator",
            "access_date",
            "geography",
            "time_grain",
            "unit",
            "rights",
            "redistribution",
            "transformations",
            "limitations"
          ],
          "properties": {
            "class": {
              "enum": [
                "observed",
                "synthetic",
                "proxy"
              ]
            },
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "source_or_generator": {
              "type": "string",
              "minLength": 1
            },
            "access_date": {
              "type": "string",
              "format": "date"
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "time_grain": {
              "enum": [
                "month"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "rights": {
              "type": "string",
              "minLength": 1
            },
            "redistribution": {
              "enum": [
                "allowed",
                "not_allowed",
                "unknown"
              ]
            },
            "transformations": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "synthetic_media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "publisher",
            "source_or_generator",
            "access_date",
            "geography",
            "time_grain",
            "unit",
            "rights",
            "redistribution",
            "transformations",
            "limitations"
          ],
          "properties": {
            "class": {
              "const": "synthetic"
            },
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "source_or_generator": {
              "type": "string",
              "minLength": 1
            },
            "access_date": {
              "type": "string",
              "format": "date"
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "time_grain": {
              "enum": [
                "month"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "rights": {
              "type": "string",
              "minLength": 1
            },
            "redistribution": {
              "enum": [
                "allowed",
                "not_allowed",
                "unknown"
              ]
            },
            "transformations": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "semi_synthetic_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "publisher",
            "source_or_generator",
            "access_date",
            "geography",
            "time_grain",
            "unit",
            "rights",
            "redistribution",
            "transformations",
            "limitations"
          ],
          "properties": {
            "class": {
              "const": "synthetic"
            },
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "source_or_generator": {
              "type": "string",
              "minLength": 1
            },
            "access_date": {
              "type": "string",
              "format": "date"
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "time_grain": {
              "enum": [
                "month"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "rights": {
              "type": "string",
              "minLength": 1
            },
            "redistribution": {
              "enum": [
                "allowed",
                "not_allowed",
                "unknown"
              ]
            },
            "transformations": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_start",
        "train_end",
        "test_start",
        "test_end"
      ],
      "properties": {
        "train_start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "train_end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "test_start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "test_end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      }
    },
    "missing_policy": {
      "const": "reject"
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "method",
        "target",
        "predictors",
        "transform_order",
        "parameters",
        "parameter_policy"
      ],
      "properties": {
        "runtime": {
          "const": "python"
        },
        "method": {
          "const": "ols"
        },
        "target": {
          "const": "semi_synthetic_outcome"
        },
        "predictors": {
          "const": [
            "observed_registrations",
            "hill_adstock_media"
          ]
        },
        "transform_order": {
          "const": [
            "geometric_adstock",
            "hill"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alpha",
            "l_max",
            "normalize",
            "k",
            "n"
          ],
          "properties": {
            "alpha": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "l_max": {
              "type": "integer",
              "minimum": 0
            },
            "normalize": {
              "const": false
            },
            "k": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "n": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "parameter_policy": {
          "const": "predeclared_oracle_transforms_no_truth_file_access"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input_kind": {
            "const": "observed_reference"
          }
        }
      },
      "then": {
        "properties": {
          "columns": {
            "properties": {
              "observed_registrations": {
                "properties": {
                  "class": {
                    "const": "observed"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_kind": {
            "const": "synthetic_fixture"
          }
        }
      },
      "then": {
        "properties": {
          "columns": {
            "properties": {
              "observed_registrations": {
                "properties": {
                  "class": {
                    "const": "synthetic"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
