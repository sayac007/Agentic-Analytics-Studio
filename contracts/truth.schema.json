{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-analytics-studio.invalid/contracts/truth.schema.json",
  "title": "truth v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "estimator_access",
    "data",
    "reference",
    "parameters",
    "media_coefficient",
    "noise_sd",
    "training_reference_mean",
    "equation",
    "true_contribution_monthly",
    "true_response_grid",
    "true_response",
    "claim",
    "generator",
    "dataset_id"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "purpose": {
      "enum": [
        "contract_fixture",
        "development_benchmark"
      ]
    },
    "estimator_access": {
      "const": false
    },
    "data": {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    "reference": {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    "parameters": {
      "$ref": "common.schema.json#/$defs/parameters"
    },
    "media_coefficient": {
      "type": "number",
      "minimum": 0
    },
    "noise_sd": {
      "type": "number",
      "minimum": 0
    },
    "training_reference_mean": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "equation": {
      "const": "outcome = reference + media_coefficient * hill(adstock(media)) + noise"
    },
    "true_contribution_monthly": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "true_response_grid": {
      "$ref": "common.schema.json#/$defs/grid"
    },
    "true_response": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2
    },
    "claim": {
      "const": "benchmark_recovery_not_real_causal_marketing_roi"
    },
    "generator": {
      "$ref": "common.schema.json#/$defs/artifact"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
