{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth contract v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "data",
    "estimator_access",
    "generator",
    "parameters",
    "coefficients",
    "equation",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![.]{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?![.]{1,2}(?:/|$))[A-Za-z0-9_.-]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "estimator_access": {
      "const": false
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "seed",
        "rng",
        "noise_distribution",
        "noise_sd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "rng": {
          "type": "string",
          "minLength": 1
        },
        "noise_distribution": {
          "enum": [
            "normal",
            "none"
          ]
        },
        "noise_sd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha",
        "l_max",
        "normalize",
        "k",
        "n"
      ],
      "properties": {
        "alpha": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "l_max": {
          "type": "integer",
          "minimum": 0
        },
        "normalize": {
          "const": false
        },
        "k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intercept",
        "observed_reference",
        "media"
      ],
      "properties": {
        "intercept": {
          "type": "number"
        },
        "observed_reference": {
          "type": "number"
        },
        "media": {
          "type": "number"
        }
      }
    },
    "equation": {
      "const": "y = intercept + observed_reference * observed_registrations + media * hill(adstock(synthetic_media)) + noise"
    },
    "claim": {
      "const": "injected_effect_only_not_real_tesla_roi"
    }
  }
}
